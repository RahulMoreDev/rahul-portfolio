PORT=5000
MONGODB_URI=mongodb+srv://<db_user>:<db_password>@<cluster-host>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters-long
NODE_ENV=development
OPENAI_API_KEY=replace-with-a-new-server-side-api-key
OPENAI_MODEL=gpt-4o-mini
PORTFOLIO_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
